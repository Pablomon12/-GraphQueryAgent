@prefix ex: <http://example.org/health#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

ex:Patient a owl:Class ;
    rdfs:label "Patient" ;
    rdfs:comment "A patient in the clinical dataset." .

ex:Diagnosis a owl:Class ;
    rdfs:label "Diagnosis" ;
    rdfs:comment "A medical diagnosis assigned to a patient." .

ex:hasDiagnosis a owl:ObjectProperty ;
    rdfs:label "has diagnosis" ;
    rdfs:domain ex:Patient ;
    rdfs:range ex:Diagnosis .

ex:displayName a owl:DatatypeProperty ;
    rdfs:label "display name" ;
    rdfs:domain ex:Patient .

ex:code a owl:DatatypeProperty ;
    rdfs:label "code" ;
    rdfs:domain ex:Diagnosis .
